# Maintainer: femgore
#
# The source expects the matching release tag.

pkgname=seabunny
pkgver=0.2.2
pkgrel=1
pkgdesc='Qt/QML file manager with an optional XDG Desktop Portal file chooser'
arch=('x86_64')
url='https://github.com/femgore/seabunny'
license=('MIT')
depends=(
  'qt6-base'
  'qt6-declarative'
  'qt6-svg'
  'qt6-wayland'
  'kwindowsystem'
  'glib2'
  'python'
  'libarchive'
  '7zip'
  'zip'
)
makedepends=('rust' 'cargo' 'cmake' 'ninja' 'pkgconf')
optdepends=(
  'ffmpeg: video thumbnails'
)
source=("git+https://github.com/femgore/seabunny.git#tag=v${pkgver}")
sha256sums=('SKIP')

build() {
  cd "$srcdir/seabunny"
  CC=/usr/bin/gcc CXX=/usr/bin/g++ \
    CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER=/usr/bin/gcc \
    RUSTFLAGS='-C linker=/usr/bin/gcc -C link-arg=-fuse-ld=bfd' \
    cargo build --release --locked
}

package() {
  cd "$srcdir/seabunny"

  install -Dm755 target/release/seabunny "$pkgdir/usr/bin/seabunny"
  install -Dm755 target/release/xdg-desktop-portal-seabunny \
    "$pkgdir/usr/bin/xdg-desktop-portal-seabunny"
  install -Dm644 packaging/seabunny/org.femgore.Seabunny.desktop \
    "$pkgdir/usr/share/applications/org.femgore.Seabunny.desktop"
  install -Dm644 packaging/seabunny/org.femgore.Seabunny.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/org.femgore.Seabunny.svg"
  install -Dm644 packaging/seabunny/org.femgore.Seabunny-symbolic.svg \
    "$pkgdir/usr/share/icons/hicolor/symbolic/apps/org.femgore.Seabunny-symbolic.svg"
  install -Dm644 packaging/seabunny/seabunny.portal \
    "$pkgdir/usr/share/xdg-desktop-portal/portals/seabunny.portal"
  install -Dm644 packaging/seabunny/org.freedesktop.impl.portal.desktop.seabunny.service.in \
    "$pkgdir/usr/share/dbus-1/services/org.freedesktop.impl.portal.desktop.seabunny.service"
  sed -i 's|@EXEC@|/usr/bin/xdg-desktop-portal-seabunny|' \
    "$pkgdir/usr/share/dbus-1/services/org.freedesktop.impl.portal.desktop.seabunny.service"
  install -Dm644 README.md "$pkgdir/usr/share/doc/seabunny/README.md"
  install -Dm644 CHANGELOG.md "$pkgdir/usr/share/doc/seabunny/CHANGELOG.md"
  install -Dm644 packaging/seabunny/PORTAL.md \
    "$pkgdir/usr/share/doc/seabunny/PORTAL.md"
  install -Dm644 NOTICE.md "$pkgdir/usr/share/doc/seabunny/NOTICE.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/seabunny/LICENSE"
  install -Dm644 assets/fonts/Phosphor-LICENSE.txt \
    "$pkgdir/usr/share/licenses/seabunny/Phosphor-LICENSE.txt"
  install -Dm644 assets/fonts/NerdFontsSymbolsOnly-LICENSE.txt \
    "$pkgdir/usr/share/licenses/seabunny/NerdFontsSymbolsOnly-LICENSE.txt"
}
